  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",

    "dev": "pnpm tsx watch --ignore src/generated server.ts",
    "dev:workers": "pnpm run \"/^worker:.*/\"",

    "build": "tsc",
    "start": "node dist/server.js",
    "workers": "pnpm run \"/^worker:.*/\"",

    "worker:import:dev": "pnpm tsx watch --ignore src/generated src/workers/import.worker.ts",
    "worker:product:dev": "pnpm tsx watch --ignore src/generated src/workers/product.worker.ts",
    "worker:snapshot:dev": "pnpm tsx watch --ignore src/generated src/workers/snapshot.worker.ts",
    "worker:stock:dev": "pnpm tsx watch --ignore src/generated src/workers/stock.worker.ts",
    "worker:analytics:dev": "pnpm tsx watch --ignore src/generated src/workers/analytics.worker.ts",
    "worker:monthly:dev": "pnpm tsx watch --ignore src/generated src/workers/monthly.worker.ts",

    "worker:import": "node dist/src/workers/import.worker.js",
    "worker:product": "node dist/src/workers/product.worker.js",
    "worker:snapshot": "node dist/src/workers/snapshot.worker.js",
    "worker:stock": "node dist/src/workers/stock.worker.js",
    "worker:analytics": "node dist/src/workers/analytics.worker.js",
    "worker:monthly": "node dist/src/workers/monthly.worker.js"
  },
